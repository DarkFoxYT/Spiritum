{
  "model": {
    "type": "minecraft:select", "property": "minecraft:display_context",
    "cases": [{"when": ["gui", "ground", "fixed"], "model": {"type": "minecraft:model", "model": "spiritum:item/retrosonus_icon"}}],
    "fallback": {"type": "minecraft:condition", "property": "minecraft:using_item",
      "on_true": {"type": "minecraft:model", "model": "spiritum:item/retrosonus_pointing"},
      "on_false": {"type": "minecraft:model", "model": "spiritum:item/retrosonus"}}
  }
}
